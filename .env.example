# ==============================================================================
# FastQR / ReviewBoost — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Review Engine (Google Gemini Flash)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
# Free tier includes 1,500 requests per day (sub-400ms review generation).
# If omitted or left blank, the app automatically uses the built-in 0ms
# offline heuristic review engine without any errors.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here # Alternative alias

# ------------------------------------------------------------------------------
# 2. Application Base URL
# ------------------------------------------------------------------------------
# Used for generating full QR code scan URLs and deep links.
# Local Development: http://localhost:3000
# Production: https://scanner.sayalabs.in
NEXT_PUBLIC_APP_URL=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 3. Cloudflare Deployment (Optional / Auto-configured)
# ------------------------------------------------------------------------------
# Used by @opennextjs/cloudflare during build and deployment.
OPEN_NEXT_ORIGIN=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 4. Future Supabase Database Integration (Optional)
# ------------------------------------------------------------------------------
# When switching from local file-backed storage to hosted Supabase PostgreSQL:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 5. Admin Authentication & Security (Optional)
# ------------------------------------------------------------------------------
# Set a secret key to restrict access to /admin routes if desired:
# ADMIN_ACCESS_TOKEN=your_super_secret_admin_token
