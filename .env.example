# ==============================================================================
# Credo Scanner — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication (Clerk) — REQUIRED to open /admin
# ------------------------------------------------------------------------------
# Create an application at https://dashboard.clerk.com and copy the API keys:
#   https://dashboard.clerk.com -> API Keys
# In development (`npm run dev`) Clerk keyless mode works even without keys.
# For Cloudflare deployments these must also be set as Worker secrets:
#   npx wrangler secret put NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   npx wrangler secret put CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL) — strongly recommended for production
# ------------------------------------------------------------------------------
# Stores, firewall feedback, and scan telemetry live in Supabase.
# Without these values the app falls back to a local JSON file (.data/store-data.json)
# which does NOT persist on serverless platforms such as Cloudflare Workers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Only used by scripts/setup-supabase.cjs to create the schema:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI Review Engine (Google Gemini Flash) — optional
# ------------------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/
# If omitted, the built-in 0ms offline heuristic review engine is used.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here # Alternative alias

# ------------------------------------------------------------------------------
# 4. Application Base URL
# ------------------------------------------------------------------------------
# Used for generating full QR code scan URLs and deep links.
NEXT_PUBLIC_APP_URL=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 5. Cloudflare Deployment (Optional)
# ------------------------------------------------------------------------------
OPEN_NEXT_ORIGIN=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 6. Testing / local development override (optional)
# ------------------------------------------------------------------------------
# Point the JSON fallback files at custom paths (tests use temp files).
# STORE_DATA_FILE=/absolute/path/to/store-data.json
# MENU_DATA_FILE=/absolute/path/to/menu-data.json
# BILLING_DATA_FILE=/absolute/path/to/billing-data.json

# ------------------------------------------------------------------------------
# 7. CSRF trusted hosts (optional)
# ------------------------------------------------------------------------------
# Comma-separated public hostnames that may appear in the `Origin` header of a
# cookie-authenticated admin mutation. Only needed when the app runs behind a
# proxy/CDN so the request URL carries an internal hostname (e.g. the Worker)
# rather than the public one.
#
# Do NOT rely on `X-Forwarded-Host` for this: it is a client-settable header, so
# trusting it would let any cross-site request claim to be same-origin.
# CSRF_TRUSTED_HOSTS=scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 8. Rate-limit client identity (optional)
# ------------------------------------------------------------------------------
# The public endpoints (/api/events, /api/feedback) are rate limited per client.
# `cf-connecting-ip` is always trusted (Cloudflare overwrites it), so nothing is
# required on Cloudflare.
#
# On any other deployment, set this to a header your proxy genuinely overwrites.
# Do NOT point it at `x-forwarded-for` / `x-real-ip`: a client can set those per
# request, which would put every request in a fresh bucket and disable the limit.
# If unset, all clients share one bucket — safe, but blunt.
# RATE_LIMIT_TRUSTED_IP_HEADER=

# ------------------------------------------------------------------------------
# 9. Supplier identity for GST tax invoices (India B2B)
# ------------------------------------------------------------------------------
# Generating a tax invoice at /api/revenue/invoice?storeId=<id> needs your own
# GSTIN. It is read from the environment, never from a request body, so nobody
# can render an invoice claiming to come from you.
#
# Register for GST above Rs 20 lakh turnover in services (SaaS is taxed at 18%),
# and note that e-invoicing to the IRP is only mandatory above Rs 5 crore. The
# generated document says plainly that it is not an e-invoice.
# SUPPLIER_GSTIN=29ABCDE1234F1Z5
# SUPPLIER_NAME=SayaLabs
# SUPPLIER_ADDRESS="Bengaluru, Karnataka"

# ------------------------------------------------------------------------------
# 10. Payments (Razorpay) — REQUIRED to sell subscriptions online
# ------------------------------------------------------------------------------
# Create an account at https://razorpay.com and copy the keys from
#   Dashboard -> Account & Settings -> API Keys
#
# RAZORPAY_KEY_ID is public: it is sent to the browser with the checkout
# options. RAZORPAY_KEY_SECRET signs the checkout handshake and must stay
# server-side. RAZORPAY_WEBHOOK_SECRET is the secret YOU choose when adding a
# webhook at Dashboard -> Account & Settings -> Webhooks pointing at
#   https://<your-domain>/api/billing/webhook
# subscribed to `payment.captured`, `payment.failed` and `order.paid`. The
# webhook is the source of truth for "the money moved" and is what activates a
# subscription when the customer closes the browser mid-checkout.
#
# With none of these set the product still runs — plans and coupons are managed
# from /admin/billing and subscriptions can be recorded by hand at
# /admin/revenue — but tenants cannot pay online, and exchange of money is the
# one thing that cannot be faked.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
