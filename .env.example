[TEMPLATE]
# ==============================================================================
# ReviewBoost Scanner — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication (Clerk) — REQUIRED to open /admin
# ------------------------------------------------------------------------------
# Create an application at https://dashboard.clerk.com and copy the API keys:
#   https://dashboard.clerk.com -> API Keys
# In development (`npm run dev`) Clerk keyless mode works even without keys.
# For Cloudflare deployments these must also be set as Worker secrets:
#   npx wrangler secret put NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   npx wrangler secret put CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL) — strongly recommended for production
# ------------------------------------------------------------------------------
# Stores, firewall feedback, and scan telemetry live in Supabase.
# Without these values the app falls back to a local JSON file (.data/store-data.json)
# which does NOT persist on serverless platforms such as Cloudflare Workers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Only used by scripts/setup-supabase.cjs to create the schema:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI Review Engine (Google Gemini Flash) — optional
# ------------------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/
# If omitted, the built-in 0ms offline heuristic review engine is used.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here # Alternative alias

# ------------------------------------------------------------------------------
# 4. Application Base URL
# ------------------------------------------------------------------------------
# Used for generating full QR code scan URLs and deep links.
NEXT_PUBLIC_APP_URL=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 5. Cloudflare Deployment (Optional)
# ------------------------------------------------------------------------------
OPEN_NEXT_ORIGIN=https://scanner.sayalabs.in

# ------------------------------------------------------------------------------
# 6. Testing / local development override (optional)
# ------------------------------------------------------------------------------
# Point the JSON fallback store at a custom file path (tests use a temp file).
# STORE_DATA_FILE=/absolute/path/to/store-data.json
